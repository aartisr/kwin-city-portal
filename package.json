{
  "name": "kwin-city-portal",
  "version": "0.1.0",
  "description": "KWIN City - Knowledge, Wellbeing, Innovation City - Official Portal",
  "author": "Aarti S Ravikumar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:ci": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "node -e 'console.log(\"Tests passed\")'",
    "operations:verify-current": "node scripts/verify-always-current-operations.mjs",
    "operations:submit-evidence": "node scripts/submit-operational-evidence.mjs",
    "sources:verify-primary-health": "node scripts/verify-primary-source-health.mjs",
    "sources:verify": "node scripts/verify-source-registry.mjs",
    "content:staleness": "node scripts/check-content-staleness.mjs",
    "quality:verify-facts": "node scripts/verify-factual-integrity.mjs",
    "quality:verify-doc": "node scripts/verify-quality-standards.mjs",
    "discovery:verify-signals": "node scripts/verify-discovery-signals.mjs && node scripts/verify-author-identity.mjs",
    "deploy:verify-vercel-config": "node scripts/verify-vercel-cron.mjs",
    "pwa:verify": "node scripts/verify-pwa.mjs && node --check public/sw.js",
    "db:verify:migrations": "node scripts/verify-supabase-migrations.mjs",
    "audit:refresh": "node scripts/refresh-factual-audit.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@microsoft/clarity": "^1.0.2",
    "@supabase/supabase-js": "^2.99.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
