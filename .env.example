# KWIN City Portal - Environment Variables

# Next.js
NEXT_PUBLIC_APP_NAME="KWIN City Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mapbox (Optional - for future spatial visualization)
# NEXT_PUBLIC_MAPBOX_TOKEN=your_token_here

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=your_ga_id_here
NEXT_PUBLIC_CLARITY_PROJECT_ID=w90fdbtt4x

# Contact inbox
CONTACT_EMAIL="hello@kwin-city.com"

# Discovery signals (optional)
# INDEXNOW_KEY=your_indexnow_key
# INDEXNOW_HOST=kwin-city.com

# Vercel Cron (recommended for /api/cron/kwin-seo-agency)
# CRON_SECRET=generate-a-random-string-with-at-least-16-characters
# Dedicated HMAC secret for append-only CI verification evidence. Use at least 32 random bytes.
# OPERATIONS_EVIDENCE_SECRET=generate-a-separate-random-secret
# Production origin used by the GitHub evidence submission script.
# SITE_BASE_URL=https://kwin-city.com

# Durable persistence (required on serverless production deployments)
# Supported values: file (development fallback), supabase
# KWIN_PERSISTENCE_PROVIDER=supabase
# KWIN_SUPABASE_URL=https://your-project.supabase.co
# KWIN_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this value in NEXT_PUBLIC_* variables or client code.
# KWIN_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opportunity Exchange internal notification (requires a verified Resend sender)
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL="KWIN City <contact@kwin-city.com>"
# OPPORTUNITY_LEAD_EMAIL=info@kwin-city.com

# Direct social publishing (off by default; generated drafts still work)
# SOCIAL_PUBLISHING_ENABLED=false
# SOCIAL_AUTO_APPROVE=false
# Provider request timeout in milliseconds. Network failures are recorded as indeterminate.
# SOCIAL_REQUEST_TIMEOUT_MS=25000
# META_GRAPH_API_VERSION=v25.0
# META_PAGE_ID=your-facebook-page-id
# META_PAGE_ACCESS_TOKEN=your-page-access-token
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
# Optional override. If omitted, the daily article's generated Instagram image URL is used.
# SOCIAL_DEFAULT_IMAGE_URL=https://kwin-city.com/path-to-approved-square-image.jpg

# LinkedIn publishing
# LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
# LINKEDIN_AUTHOR_URN=urn:li:organization:your-organization-id
# LINKEDIN_VERSION=202604

# X publishing
# X_USER_ACCESS_TOKEN=your-x-user-access-token

# API (Optional - for future backend integration)
# NEXT_PUBLIC_API_URL=http://localhost:3001
