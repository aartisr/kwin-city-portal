# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The API URL of your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL=""

# SUPABASE_ANON_KEY: The public/anonymous key of your Supabase project
SUPABASE_ANON_KEY=""

# FACEBOOK_PAGE_ID: The unique Page ID or custom URL handle of your Facebook Page (e.g. kwincity)
FACEBOOK_PAGE_ID="kwincity"

# FACEBOOK_PAGE_ACCESS_TOKEN: A permanent or long-lived Page Access Token generated from the Facebook Developers Portal.
# Requires 'pages_manage_posts' and 'pages_read_engagement' permissions to post updates to your page feed behind the scenes.
FACEBOOK_PAGE_ACCESS_TOKEN=""

# INSTAGRAM_ACCOUNT_ID: The Instagram Business or Creator Account ID connected to your Facebook Page.
# Obtain this via Graph API: GET /v18.0/{facebook_page_id}?fields=instagram_business_account
INSTAGRAM_ACCOUNT_ID=""

# INSTAGRAM_DEFAULT_IMAGE_URL: A publicly accessible HTTPS image URL required by Instagram Content Publishing API for image/carousel posts.
INSTAGRAM_DEFAULT_IMAGE_URL=""

# WHATSAPP_PHONE_NUMBER_ID: (Optional) Meta WhatsApp Business Cloud API Phone Number ID for automated daily WhatsApp broadcasts.
WHATSAPP_PHONE_NUMBER_ID=""

# WHATSAPP_ACCESS_TOKEN: (Optional) WhatsApp Cloud API Access Token (if distinct from Facebook Page Access Token).
WHATSAPP_ACCESS_TOKEN=""

# WHATSAPP_RECIPIENT_NUMBER: (Optional) Default recipient international phone number or broadcast group ID for WhatsApp updates (e.g. 919876543210).
WHATSAPP_RECIPIENT_NUMBER=""

# WHATSAPP_CHANNEL_URL: (Optional) Public link to your official WhatsApp Channel for one-click following.
WHATSAPP_CHANNEL_URL="https://whatsapp.com/channel/kwin-city"

# LINKEDIN_ACCESS_TOKEN: (Optional) LinkedIn OAuth access token with w_member_social or w_organization_social
LINKEDIN_ACCESS_TOKEN=""

# LINKEDIN_ORGANIZATION_ID: (Optional) LinkedIn Organization numeric ID (or LINKEDIN_PERSON_URN)
LINKEDIN_ORGANIZATION_ID=""

# TWITTER_BEARER_TOKEN: (Optional) X / Twitter API v2 Bearer Token or API key
TWITTER_BEARER_TOKEN=""
