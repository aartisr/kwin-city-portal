{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "installCommand": "yarn install --frozen-lockfile --registry https://registry.npmjs.org/",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/dist/server.cjs"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/kwin-seo-agency",
      "schedule": "11 3 * * *"
    },
    {
      "path": "/api/cron/supabase-heartbeat",
      "schedule": "41 15 * * *"
    }
  ]
}

