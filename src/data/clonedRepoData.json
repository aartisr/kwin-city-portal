            "id": "file--github-workflows-quality-yml",
            "name": "quality.yml",
            "path": ".github/workflows/quality.yml",
            "type": "file",
            "language": "yaml",
            "content": "name: Production quality gate\n\non:\n  pull_request:\n  push:\n    branches: [master]\n  workflow_dispatch:\n\n# A newer commit supersedes an older validation run for the same pull request\n# or branch. This keeps the status Vercel and reviewers see aligned with the\n# code that is actually about to ship.\nconcurrency:\n  group: production-quality-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}\n  cancel-in-progress: true\n\npermissions:\n  contents: read\n\njobs:\n  verify:\n    name: Test, build, and validate deployment contract\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n          cache: npm\n      - run: npm ci --include=dev --include=optional\n      - run: npm run quality:gate\n      # Date-only logic must remain correct for users outside the UTC CI host.\n      - name: Verify PWA and date boundaries in America/New_York\n        env:\n          TZ: America/New_York\n        run: npm run test:pwa-contract -w apps/web && npm run test -w apps/web -- src/core/domain/dateOnly.test.ts\n\n  security:\n    name: Production dependency security scan\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n          cache: npm\n      - run: npm ci --include=optional\n      - run: npm run check:security\n\n  database:\n    name: Replay every Supabase migration from scratch\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    steps:\n      - uses: actions/checkout@v4\n      - uses: supabase/setup-cli@v1\n        with:\n          # Keep the CI database engine aligned with the committed CLI. A\n          # floating \"latest\" version can make the same migration pass one day\n          # and fail the next without a repository change.\n          version: 2.110.0\n      - name: Verify migration history is complete and unambiguous\n        run: npm run verify:migrations\n      - name: Start an isolated Supabase stack\n        run: supabase db start\n      - name: Prove the schema is reproducible\n        run: supabase db reset --local --no-seed\n      - name: Lint the resulting database schema\n        run: supabase db lint --local --fail-on error\n",
            "isModified": false
