          {
            "id": "file-supabase-migrations-023_delete_attachment_metadata_instead_of_soft_delete-sql",
            "name": "023_delete_attachment_metadata_instead_of_soft_delete.sql",
            "path": "supabase/migrations/023_delete_attachment_metadata_instead_of_soft_delete.sql",
