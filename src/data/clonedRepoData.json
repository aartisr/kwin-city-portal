            "type": "file",
            "language": "html",
            "content": "<!doctype html>\n<html lang=\"en\" prefix=\"og: https://ogp.me/ns#\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n\n    <!-- ===== PRIMARY SEO ===== -->\n    <title>Task-Laureate — A calm, private task workspace</title>\n    <meta name=\"description\" content=\"Task-Laureate is a free, open-source, local-first task workspace for turning a crowded day into one clear next action.\" />\n    <meta name=\"keywords\" content=\"calm task manager, next action app, local-first productivity, private todo app, open source task manager, task dependencies, focused work\" />\n    <meta name=\"robots\" content=\"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1\" />\n    <meta name=\"googlebot\" content=\"index, follow\" />\n    <link rel=\"canonical\" href=\"https://tasks.ai-aarti.com/\" />\n\n    <!-- ===== OPEN GRAPH (Facebook, LinkedIn, Slack, Discord, WhatsApp) ===== -->\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:site_name\" content=\"Task-Laureate\" />\n    <meta property=\"og:title\" content=\"Task-Laureate — A calm, private task workspace\" />\n    <meta property=\"og:description\" content=\"Plan lists, prioritize tasks, and see honest progress in a focused personal workspace.\" />\n    <meta property=\"og:url\" content=\"https://tasks.ai-aarti.com/\" />\n    <meta property=\"og:image\" content=\"https://tasks.ai-aarti.com/og-image-v2.png\" />\n    <meta property=\"og:image:width\" content=\"1200\" />\n    <meta property=\"og:image:height\" content=\"630\" />\n    <meta property=\"og:image:type\" content=\"image/png\" />\n    <meta property=\"og:locale\" content=\"en_US\" />\n    <meta property=\"og:image:alt\" content=\"Task-Laureate task workspace for clear next actions and honest progress\" />\n\n    <!-- ===== TWITTER / X CARDS ===== -->\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Task-Laureate — A calm, private task workspace\" />\n    <meta name=\"twitter:description\" content=\"Plan lists, prioritize tasks, and see honest progress in a focused personal workspace.\" />\n    <meta name=\"twitter:image\" content=\"https://tasks.ai-aarti.com/og-image-v2.png\" />\n    <meta name=\"twitter:image:alt\" content=\"Task-Laureate task workspace\" />\n\n    <!-- ===== PWA & MOBILE ===== -->\n    <meta name=\"theme-color\" content=\"#8b5cf6\" media=\"(prefers-color-scheme: dark)\" />\n    <meta name=\"theme-color\" content=\"#7c3aed\" media=\"(prefers-color-scheme: light)\" />\n    <meta name=\"mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n    <meta name=\"apple-mobile-web-app-title\" content=\"Task-Laureate\" />\n    <meta name=\"application-name\" content=\"Task-Laureate\" />\n    <link rel=\"manifest\" href=\"/manifest.json\" />\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/icons/apple-touch-icon-180.png\" />\n\n    <!-- ===== FAVICONS ===== -->\n    <link rel=\"icon\" type=\"image/svg+xml\" sizes=\"any\" href=\"/favicon.svg?v=2\" />\n    <link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/icons/task-laureate-192.png\" />\n\n    <!-- ===== PRECONNECT & PERFORMANCE ===== -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\" />\n    <link rel=\"dns-prefetch\" href=\"https://tasks.ai-aarti.com\" />\n\n    <!-- Humans & AI discovery -->\n    <link rel=\"author\" href=\"/humans.txt\" />\n    <link rel=\"alternate\" type=\"text/plain\" href=\"/llms.txt\" title=\"AI-readable documentation\" />\n\n    <!-- ===== AUTHOR META ===== -->\n    <meta name=\"author\" content=\"Aarti S Ravikumar\" />\n    <meta name=\"creator\" content=\"Aarti S Ravikumar\" />\n    <meta name=\"publisher\" content=\"Aarti S Ravikumar\" />\n    <meta name=\"copyright\" content=\"Aarti S Ravikumar\" />\n    <meta name=\"designer\" content=\"Aarti S Ravikumar\" />\n    <meta property=\"article:author\" content=\"https://ai-aarti.com\" />\n    <meta name=\"profile:username\" content=\"aartisr\" />\n\n    <meta name=\"google-site-verification\" content=\"tmJdGSqIVamjJZqqp4RtfM-gJ_W6FMHUJ7duICyOFVo\" />\n\n    <!-- Structured facts for search systems. Kept deliberately small and verifiable. -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@graph\": [\n        {\n          \"@type\": \"WebApplication\",\n          \"@id\": \"https://tasks.ai-aarti.com/#app\",\n          \"name\": \"Task-Laureate\",\n          \"alternateName\": [\"Task Laureate\", \"TaskLaureate\"],\n          \"description\": \"A privacy-minded personal task workspace for planning lists, prioritizing tasks, tracking progress, and reviewing activity.\",\n          \"url\": \"https://tasks.ai-aarti.com/\",\n          \"applicationCategory\": \"UtilitiesApplication\",\n          \"applicationSubCategory\": \"Task Management\",\n          \"operatingSystem\": \"Web browser\",\n          \"offers\": {\n            \"@type\": \"Offer\",\n            \"price\": \"0\",\n            \"priceCurrency\": \"USD\"\n          },\n          \"featureList\": [\n            \"Task list management\",\n            \"Task prioritization (Urgent, High, Medium, Low)\",\n            \"Progress tracking and analytics\",\n            \"Activity timeline\",\n            \"Search across all tasks\",\n            \"Multiple visual themes\",\n            \"Responsive web interface\",\n            \"Task dependencies and clear in-progress status\",\n            \"Private task attachments with fast previews\"\n          ],\n          \"screenshot\": \"https://tasks.ai-aarti.com/og-image-v2.png\",\n          \"softwareVersion\": \"1.0.0\",\n          \"inLanguage\": \"en\",\n          \"isAccessibleForFree\": true,\n          \"author\": { \"@id\": \"https://tasks.ai-aarti.com/#author\" },\n          \"creator\": { \"@id\": \"https://tasks.ai-aarti.com/#author\" },\n          \"publisher\": { \"@id\": \"https://tasks.ai-aarti.com/#author\" }\n        },\n        {\n          \"@type\": \"Person\",\n          \"@id\": \"https://tasks.ai-aarti.com/#author\",\n          \"name\": \"Aarti S Ravikumar\",\n          \"givenName\": \"Aarti\",\n          \"familyName\": \"Ravikumar\",\n          \"url\": \"https://ai-aarti.com\",\n          \"sameAs\": [\n            \"https://ai-aarti.com\",\n            \"https://github.com/aartisr\"\n          ],\n          \"description\": \"Developer of Task-Laureate.\",\n          \"jobTitle\": \"Developer\",\n          \"knowsAbout\": [\n            \"TypeScript\",\n            \"React\",\n            \"Task Management\",\n            \"Software Engineering\",\n            \"Open Source Development\",\n            \"Web Development\",\n            \"Full-Stack Development\"\n          ]\n        },\n        {\n          \"@type\": \"WebSite\",\n          \"@id\": \"https://tasks.ai-aarti.com/#website\",\n          \"url\": \"https://tasks.ai-aarti.com/\",\n          \"name\": \"Task-Laureate\",\n          \"description\": \"A calm, privacy-minded personal task workspace.\",\n          \"author\": { \"@id\": \"https://tasks.ai-aarti.com/#author\" }\n        }\n      ]\n    }\n    </script>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <noscript>\n      <main>\n        <h1>Task-Laureate: a calm, private task workspace</h1>\n        <p>Plan lists, prioritize tasks, keep due dates, rich notes, attachments, and dependencies together, and review progress without turning personal work into a noisy project-management system.</p>\n        <p>Task-Laureate is a responsive, open-source web application for individuals. You can use account-scoped Supabase sync when it is configured, or learn more about the product and its data practices.</p>\n        <p><a href=\"/about/\">Learn about Task-Laureate</a> · <a href=\"/support\">Get support</a> · <a href=\"https://github.com/aartisr/task-laureate\">View the source</a></p>\n      </main>\n    </noscript>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n",
