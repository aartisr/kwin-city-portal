                "content": "// This is your Prisma schema file,\n// learn more about it in the docs: https://pris.ly/d/prisma-schema\n\ngenerator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\n// ============================================================================\n// Core Domain Models\n// ============================================================================\n\n/// TodoList represents a collection of related tasks\nmodel TodoList {\n  id                String       @id @default(cuid())\n  title             String       @db.VarChar(255)\n  description       String       @default(\"\") @db.Text\n  status            ListStatus   @default(ACTIVE)\n  templateId        String?\n  \n  // Aggregated fields (computed from tasks)\n  taskCount         Int          @default(0)\n  completedTaskCount Int         @default(0)\n  completionPercent Float        @default(0)\n  \n  // Timestamps\n  createdAt         DateTime     @default(now())\n  updatedAt         DateTime     @updatedAt\n  archivedAt        DateTime?\n  deletedAt         DateTime?\n  \n  // Relations\n  tasks             TodoItem[]\n  activities        ActivityEvent[]\n  \n  @@index([status])\n  @@index([deletedAt])\n  @@map(\"todo_lists\")\n}\n\n/// TodoItem represents a single task within a list\nmodel TodoItem {\n  id                String       @id @default(cuid())\n  listId            String\n  title             String       @db.VarChar(255)\n  notes             String       @default(\"\") @db.Text\n  status            TaskStatus   @default(TODO)\n  priority          Priority     @default(MEDIUM)\n  dueDate           DateTime?\n  tags              String[]     @default([])\n  order             Int          @default(0)\n  \n  // Timestamps\n  createdAt         DateTime     @default(now())\n  updatedAt         DateTime     @updatedAt\n  completedAt       DateTime?\n  deletedAt         DateTime?\n  \n  // Relations\n  list              TodoList     @relation(fields: [listId], references: [id], onDelete: Cascade)\n  activities        ActivityEvent[]\n  \n  @@index([listId])\n  @@index([status])\n  @@index([priority])\n  @@index([dueDate])\n  @@index([deletedAt])\n  @@map(\"todo_items\")\n}\n\n/// ActivityEvent tracks all mutations for audit trail\nmodel ActivityEvent {\n  id                String       @id @default(cuid())\n  entityType        String       @db.VarChar(50)  // \"list\" | \"task\"\n  entityId          String\n  action            String       @db.VarChar(50)  // \"created\" | \"updated\" | \"completed\" | \"deleted\"\n  actor             String       @default(\"system\") @db.VarChar(100)\n  metadata          Json         @default(\"{}\")\n  timestamp         DateTime     @default(now())\n  \n  // Relations (polymorphic pattern)\n  list              TodoList?    @relation(fields: [listId], references: [id], onDelete: Cascade)\n  listId            String?\n  task              TodoItem?    @relation(fields: [taskId], references: [id], onDelete: Cascade)\n  taskId            String?\n  \n  @@index([entityType])\n  @@index([entityId])\n  @@index([timestamp])\n  @@index([listId])\n  @@index([taskId])\n  @@map(\"activity_events\")\n}\n\n/// ListTemplate provides starter templates for new lists\nmodel ListTemplate {\n  id                String       @id @default(cuid())\n  title             String       @db.VarChar(255)\n  description       String       @default(\"\") @db.Text\n  listDefaults      Json         @default(\"{}\")\n  taskDefaults      Json[]       @default([])\n  \n  // Timestamps\n  createdAt         DateTime     @default(now())\n  updatedAt         DateTime     @updatedAt\n  \n  @@map(\"list_templates\")\n}\n\n// ============================================================================\n// Enums\n// ============================================================================\n\nenum ListStatus {\n  ACTIVE\n  ARCHIVED\n}\n\nenum TaskStatus {\n  TODO\n  DOING\n  DONE\n  BLOCKED\n}\n\nenum Priority {\n  LOW\n  MEDIUM\n  HIGH\n  CRITICAL\n}\n",
