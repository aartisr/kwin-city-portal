                "type": "file",
                "language": "plaintext",
                "content": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1200\" height=\"630\" viewBox=\"0 0 1200 630\">\n  <defs>\n    <!-- Background gradient -->\n    <linearGradient id=\"bg\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#0d0d0d\"/>\n      <stop offset=\"100%\" stop-color=\"#1a1a1a\"/>\n    </linearGradient>\n    <!-- Purple glow gradient -->\n    <radialGradient id=\"glow1\" cx=\"30%\" cy=\"40%\" r=\"50%\">\n      <stop offset=\"0%\" stop-color=\"#8b5cf6\" stop-opacity=\"0.25\"/>\n      <stop offset=\"100%\" stop-color=\"#8b5cf6\" stop-opacity=\"0\"/>\n    </radialGradient>\n    <!-- Blue accent gradient -->\n    <radialGradient id=\"glow2\" cx=\"80%\" cy=\"60%\" r=\"40%\">\n      <stop offset=\"0%\" stop-color=\"#3b82f6\" stop-opacity=\"0.18\"/>\n      <stop offset=\"100%\" stop-color=\"#3b82f6\" stop-opacity=\"0\"/>\n    </radialGradient>\n    <!-- Pink accent -->\n    <radialGradient id=\"glow3\" cx=\"60%\" cy=\"90%\" r=\"35%\">\n      <stop offset=\"0%\" stop-color=\"#ec4899\" stop-opacity=\"0.12\"/>\n      <stop offset=\"100%\" stop-color=\"#ec4899\" stop-opacity=\"0\"/>\n    </radialGradient>\n    <!-- Brand gradient for text -->\n    <linearGradient id=\"brand\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n      <stop offset=\"0%\" stop-color=\"#a78bfa\"/>\n      <stop offset=\"50%\" stop-color=\"#8b5cf6\"/>\n      <stop offset=\"100%\" stop-color=\"#60a5fa\"/>\n    </linearGradient>\n    <!-- Card gradient -->\n    <linearGradient id=\"card\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#262626\"/>\n      <stop offset=\"100%\" stop-color=\"#1f1f1f\"/>\n    </linearGradient>\n    <!-- Progress bar gradient -->\n    <linearGradient id=\"bar\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n      <stop offset=\"0%\" stop-color=\"#8b5cf6\"/>\n      <stop offset=\"100%\" stop-color=\"#3b82f6\"/>\n    </linearGradient>\n    <!-- Subtle border filter -->\n    <filter id=\"blur-sm\">\n      <feGaussianBlur stdDeviation=\"1\"/>\n    </filter>\n  </defs>\n\n  <!-- Background -->\n  <rect width=\"1200\" height=\"630\" fill=\"url(#bg)\"/>\n\n  <!-- Ambient glows -->\n  <rect width=\"1200\" height=\"630\" fill=\"url(#glow1)\"/>\n  <rect width=\"1200\" height=\"630\" fill=\"url(#glow2)\"/>\n  <rect width=\"1200\" height=\"630\" fill=\"url(#glow3)\"/>\n\n  <!-- Subtle grid pattern -->\n  <pattern id=\"grid\" x=\"0\" y=\"0\" width=\"40\" height=\"40\" patternUnits=\"userSpaceOnUse\">\n    <path d=\"M 40 0 L 0 0 0 40\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"0.3\" opacity=\"0.04\"/>\n  </pattern>\n  <rect width=\"1200\" height=\"630\" fill=\"url(#grid)\"/>\n\n  <!-- Left side: Brand block -->\n  <g transform=\"translate(80, 80)\">\n\n    <!-- Badge pill -->\n    <rect x=\"0\" y=\"0\" width=\"180\" height=\"32\" rx=\"16\" fill=\"#8b5cf6\" fill-opacity=\"0.2\" stroke=\"#8b5cf6\" stroke-width=\"1\" stroke-opacity=\"0.5\"/>\n    <text x=\"90\" y=\"21\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#a78bfa\" letter-spacing=\"0.5\">Task Laureate</text>\n\n    <!-- Main title -->\n    <text y=\"100\" font-family=\"-apple-system, BlinkMacSystemFont, sans-serif\" font-size=\"72\" font-weight=\"800\" fill=\"url(#brand)\" letter-spacing=\"-1\">Task-Laureate</text>\n\n    <!-- Tagline -->\n    <text y=\"148\" font-family=\"-apple-system, BlinkMacSystemFont, sans-serif\" font-size=\"26\" font-weight=\"400\" fill=\"#b3b3b3\" letter-spacing=\"-0.3\">Calm. Fast. Premium.</text>\n\n    <!-- Description -->\n    <text y=\"205\" font-family=\"-apple-system, BlinkMacSystemFont, sans-serif\" font-size=\"18\" fill=\"#808080\">\n      <tspan>Task orchestration for high-performance teams.</tspan>\n    </text>\n    <text y=\"230\" font-family=\"-apple-system, BlinkMacSystemFont, sans-serif\" font-size=\"18\" fill=\"#808080\">\n      <tspan>Open source. Free forever.</tspa