            "id": "file--github-workflows-update-lockfile-yml",
            "name": "update-lockfile.yml",
            "path": ".github/workflows/update-lockfile.yml",
            "type": "file",
            "language": "yaml",
            "content": "name: Update package-lock.json\n\n# Runs automatically when package.json changes (e.g. a new dependency was added\n# from a machine that can't reach registry.npmjs.org directly).\n# Also supports manual trigger from the GitHub Actions UI.\non:\n  push:\n    branches: [master]\n    paths:\n      - '**/package.json'\n      - '!**/node_modules/**'\n  workflow_dispatch:\n\npermissions:\n  contents: write\n\njobs:\n  update-lockfile:\n    name: Regenerate package-lock.json\n    runs-on: ubuntu-latest\n    # Skip if the last commit was already a lock file update (avoid infinite loop)\n    if: \"!contains(github.event.head_commit.message, '[skip-lockfile]') && !contains(github.event.head_commit.message, 'sync package-lock.json')\"\n\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          # Use a token so the committed lock file triggers downstream workflows\n          token: ${{ secrets.GITHUB_TOKEN }}\n\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n\n      - name: Regenerate lock file\n        run: npm install --package-lock-only\n\n      - name: Commit updated lock file (if changed)\n        run: |\n          git config user.name  \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n          git add package-lock.json\n          git diff --staged --quiet && echo \"Lock file already up to date\" || \\\n            git commit -m \"chore: sync package-lock.json after dependency change\"\n          git push\n",
            "isModified": false
