                        "id": "file-apps-web-src-core-themes-themes-css",
                        "name": "themes.css",
                        "path": "apps/web/src/core/themes/themes.css",
                        "type": "file",
                        "language": "css",
                        "content": "/**\n * LAUREATE DESIGN SYSTEM\n * \n * Research-backed theme system inspired by world-class products:\n * Linear (task management), Figma (collaboration), Apple (refinement),\n * Stripe (professional elegance), GitHub (developer experience)\n * \n * These variables are set dynamically by ThemeProvider.tsx\n */\n\n:root {\n  /* ===== COLOR PALETTE ===== */\n  \n  /* Backgrounds - layered depth */\n  --color-bg-primary: #0a0a0a;\n  --color-bg-secondary: #1a1a1a;\n  --color-bg-tertiary: #2d2d2d;\n  --color-bg-surface: #141414;\n  --color-bg-overlay: rgba(0, 0, 0, 0.8);\n\n  /* Text - contrast-optimized */\n  --color-text-primary: #ffffff;\n  --color-text-secondary: #b3b3b3;\n  --color-text-tertiary: #808080;\n  --color-text-inverse: #000000;\n  --color-text-on-action: #000000;\n  --color-text-muted: #595959;\n\n  /* Interactive - vibrant, accessible */\n  --color-action-primary: #7c3aed;\n  --color-action-secondary: #3b82f6;\n  --color-action-hover: #9f5cef;\n  --color-action-active: #6d28d9;\n  --color-action-disabled: #4a4a4a;\n\n  /* Neutral action controls: always use this tested foreground/surface pair. */\n  --control-quiet-bg: #1a1a1a;\n  --control-quiet-fg: #f5f5f5;\n  --control-quiet-border: #4b5563;\n  --control-quiet-hover-bg: #262626;\n\n  /* Semantic - status indicators */\n  --color-status-success: #10b981;\n  --color-status-warning: #f59e0b;\n  --color-status-error: #ef4444;\n  --color-status-info: #3b82f6;\n\n  /* Borders - subtle to prominent */\n  --color-border-default: #404040;\n  --color-border-light: #2d2d2d;\n  --color-border-dark: #595959;\n  --color-border-focus: #8b5cf6;\n\n  /* Accents - brand personality */\n  --color-accent-primary: #7c3aed;\n  --color-accent-secondary: #3b82f6;\n  --color-accent-tertiary: #06b6d4;\n\n  /* ===== TYPOGRAPHY ===== */\n  \n  --font-family-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto',\n    'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans',\n    'Helvetica Neue', sans-serif;\n  --font-family-mono: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;\n  --font-family-display: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  \n  /* Refined type scales */\n  --font-weight-regular: 400;\n  --font-weight-medium: 500;\n  --font-weight-semibold: 600;\n  --font-weight-bold: 700;\n  --font-weight-extrabold: 800;\n\n  /* Line heights for readability */\n  --line-height-tight: 1.1;\n  --line-height-snug: 1.25;\n  --line-height-normal: 1.5;\n  --line-height-relaxed: 1.625;\n  --line-height-loose: 2;\n\n  /* ===== SPACING SYSTEM ===== */\n  /* 8px base unit */\n  --spacing-0: 0;\n  --spacing-1: 0.25rem; /* 4px */\n  --spacing-2: 0.5rem; /* 8px */\n  --spacing-3: 0.75rem; /* 12px */\n  --spacing-4: 1rem; /* 16px */\n  --spacing-5: 1.25rem; /* 20px */\n  --spacing-6: 1.5rem; /* 24px */\n  --spacing-8: 2rem; /* 32px */\n  --spacing-10: 2.5rem; /* 40px */\n  --spacing-12: 3rem; /* 48px */\n  --spacing-14: 3.5rem; /* 56px */\n  --spacing-16: 4rem; /* 64px */\n\n  /* ===== BORDER RADIUS ===== */\n  --radius-sm: 0.375rem; /* 6px */\n  --radius-md: 0.5rem; /* 8px */\n  --radius-lg: 0.75rem; /* 12px */\n  --radius-xl: 1rem; /* 16px */\n  --radius-2xl: 1.5rem; /* 24px */\n  --radius-full: 9999px;\n\n  /* ===== SHADOWS ===== */\n  /* Elevated, sophisticated shadows */\n  --shadow-xs: 0 1px 2px 0 rgba(0, 0, 0, 0.05);\n  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.5);\n  --shadow-md: 0 4px 6px 0 rgba(0, 0, 0, 0.5);\n  --shadow-lg: 0 10px 15px 0 rgba(0, 0, 0, 0.6);\n  --shadow-xl: 0 20px 25px 0 rgba(0, 0, 0, 0.7);\n  --shadow-2xl: 0 25px 50px 0 rgba(0, 0, 0, 0.8);\n  --shadow-inner: inset 0 2px 4px 0 rgba(0, 0, 0, 0.3);\n  --shadow-focus: 0 0 0 3px rgba(139, 92, 246, 0.1), 0 0 0 1px rgba(139, 92, 246, 0.3);\n\n  /* ===== TRANSITIONS ===== */\n  --transition-fast: 100ms ease;\n  --transition-base: 150ms ease;\n  --transition-slow: 200ms ease;\n  --transition-slower: 300ms ease;\n\n  /* ===== COMPUTED VALUES ===== */\n  --typography-scale: 1;\n  --spacing-scale: 1;\n  --border-radius-scale: 0.9;\n}\n\n/* ===== GLOBAL BASE STYLES ===== */\n\nhtml,\nbody {\n  background-color: var(--color-bg-primary);\n  color: var(--color-text-primary);\n  font-family: var(--font-family-sans);\n  font-size: 16px;\n  line-height: var(--line-height-normal);\n  transition: background-color var(--transition-base), color var(--transition-base);\n}\n\nbody {\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-rendering: optimizeLegibility;\n}\n\n/* ===== FORM ELEMENTS ===== */\n\ninput,\nselect,\ntextarea {\n  background-color: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  border-color: var(--color-border-default);\n  font-family: var(--font-family-sans);\n  transition: all var(--transition-base);\n}\n\ninput::placeholder,\ntextarea::placeholder {\n  color: var(--color-text-tertiary);\n}\n\ninput:focus,\nselect:focus,\ntextarea:focus {\n  outline: none;\n  border-color: var(--color-action-primary);\n  box-shadow: var(--shadow-focus);\n}\n\n/* ===== BUTTONS ===== */\n\nbutton {\n  font-family: var(--font-family-sans);\n  font-weight: var(--font-weight-medium);\n  cursor: pointer;\n  transition: all var(--transition-base);\n}\n\nbutton:not([class*='btn-']):focus {\n  outline: none;\n  box-shadow: var(--shadow-focus);\n}\n\n/* ===== LINKS ===== */\n\na {\n  color: var(--color-action-primary);\n  text-decoration: none;\n  transition: color var(--transition-base);\n}\n\na:hover {\n  color: var(--color-action-hover);\n}\n\na:focus {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-bg-primary), 0 0 0 4px var(--color-action-primary);\n  border-radius: 2px;\n}\n\n/* ===== SCROLLBAR ===== */\n\nhtml.dark {\n  scrollbar-color: var(--color-border-dark) var(--color-bg-secondary);\n}\n\n::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--color-bg-secondary);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--color-border-dark);\n  border-radius: 5px;\n  border: 2px solid var(--color-bg-secondary);\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--color-border-dark);\n}\n\n/* ===== SELECTION ===== */\n\n::selection {\n  background-color: var(--color-action-primary);\n  color: var(--color-text-on-action);\n}\n\n::-moz-selection {\n  background-color: var(--color-action-primary);\n  color: var(--color-text-on-action);\n}\n",
                        "isModified": false
                      },
