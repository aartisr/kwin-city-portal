            "content": "{\n  \"name\": \"@laureate/web\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"tsc --noEmit && vite build\",\n    \"postbuild\": \"node scripts/mirror-build-output.mjs\",\n    \"check:perf-budgets\": \"node scripts/check-performance-budgets.mjs\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest run\",\n    \"test:pwa-contract\": \"vitest run src/infrastructure/pwa/pwaAssets.test.ts\",\n    \"test:supabase\": \"RUN_SUPABASE_INTEGRATION=true vitest run src/infrastructure/persistence/supabase.integration.test.ts\",\n    \"test:supabase:permissions\": \"RUN_SUPABASE_PERMISSION_INTEGRATION=true vitest run src/infrastructure/persistence/supabase.permissions.integration.test.ts\",\n    \"lint\": \"tsc --noEmit\",\n    \"verify:public-registry\": \"node ../../scripts/verify-public-registry.mjs\",\n    \"verify:production\": \"npm run verify:public-registry && node ../../scripts/verify-production-config.mjs\"\n  },\n  \"dependencies\": {\n    \"@puckeditor/core\": \"^0.23.0\",\n    \"@supabase/supabase-js\": \"^2.49.8\",\n    \"@tanstack/react-query\": \"^5.59.0\",\n    \"@tanstack/react-router\": \"^1.68.0\",\n    \"@tanstack/react-table\": \"^8.20.5\",\n    \"@vercel/analytics\": \"^2.0.1\",\n    \"posthog-js\": \"1.413.3\",\n    \"react\": \"^18.3.1\",\n    \"react-dom\": \"^18.3.1\"\n  },\n  \"devDependencies\": {\n    \"@types/react\": \"^18.3.11\",\n    \"@types/react-dom\": \"^18.3.1\",\n    \"@vitejs/plugin-react\": \"^4.3.2\",\n    \"jsdom\": \"^26.1.0\",\n    \"typescript\": \"^5.6.3\",\n    \"vite\": \"^5.4.8\",\n    \"vitest\": \"^2.1.2\"\n  },\n  \"optionalDependencies\": {\n    \"@esbuild/linux-x64\": \"0.21.5\",\n    \"@rollup/rollup-linux-x64-gnu\": \"4.62.2\"\n  }\n}\n",
