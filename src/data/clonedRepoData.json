                  {
                    "id": "file-apps-web-src-styles-premium-finish-css",
                    "name": "premium-finish.css",
                    "path": "apps/web/src/styles/premium-finish.css",
                    "type": "file",
                    "language": "css",
                    "content": "/* Final shared visual layer. Kept separate from legacy page CSS so new work\n   uses one calm, token-driven premium language without selector escalation. */\n:root {\n  --premium-radius: 1.35rem;\n  --premium-radius-sm: .9rem;\n  --premium-border: color-mix(in srgb, var(--color-border-default) 78%, transparent);\n  --premium-hairline: color-mix(in srgb, var(--color-border-light) 88%, transparent);\n  --premium-highlight: color-mix(in srgb, #fff 11%, transparent);\n  --premium-shadow: 0 1.25rem 3.5rem color-mix(in srgb, #020617 13%, transparent);\n}\n\nbody { background: radial-gradient(72rem 42rem at 96% -12%, color-mix(in srgb, var(--color-action-primary) 13%, transparent), transparent 62%), radial-gradient(52rem 34rem at -12% 78%, color-mix(in srgb, var(--color-accent-secondary) 8%, transparent), transparent 68%), var(--color-bg-primary); }\n.workspace { position: relative; padding: clamp(1.1rem, 3vw, 3.25rem); }\n.workspace::before { content: ''; position: fixed; z-index: -1; inset: 0; pointer-events: none; background-image: linear-gradient(color-mix(in srgb, var(--color-border-default) 7%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--color-border-default) 7%, transparent) 1px, transparent 1px); background-size: 3.5rem 3.5rem; mask-image: radial-gradient(ellipse 80% 55% at 52% 0%, #000, transparent 82%); opacity: .32; }\n\n.page-hero, .panel, .ui-card, .data-card, .stat-card, .ui-state, .activity-page__surface, .search-page__results, .shared-resource-card, .sample-workspace__card, .sample-workspace__next { border-color: var(--premium-border); background: linear-gradient(145deg, color-mix(in srgb, var(--color-bg-secondary) 94%, transparent), color-mix(in srgb, var(--color-bg-secondary) 72%, var(--color-bg-primary))); box-shadow: var(--premium-shadow), inset 0 1px 0 var(--premium-highlight); }\n.page-hero { min-block-size: 12rem; padding: clamp(1.5rem, 4vw, 3.25rem); border-radius: calc(var(--premium-radius) + .35rem); background: radial-gradient(circle at 88% 12%, color-mix(in srgb, var(--color-action-primary) 23%, transparent), transparent 25rem), radial-gradient(circle at 100% 100%, color-mix(in srgb, var(--color-accent-secondary) 13%, transparent), transparent 24rem), linear-gradient(142deg, color-mix(in srgb, var(--color-bg-secondary) 95%, transparent), color-mix(in srgb, var(--color-bg-primary) 90%, var(--color-bg-secondary))); }\n.page-hero:hover, .panel:hover { border-color: color-mix(in srgb, var(--color-action-primary) 36%, var(--premium-border)); box-shadow: var(--premium-shadow); transform: none; }\n.page-hero h1 { max-inline-size: 15ch; font-size: clamp(2.15rem, 5vw, 4.25rem); letter-spacing: -.065em; line-height: .98; }\n.panel { margin-top: clamp(1.25rem, 3vw, 2.25rem); padding: clamp(1.1rem, 3vw, 2.25rem); border-radius: var(--premium-radius); }\n.panel-heading { gap: 1rem; margin-bottom: clamp(1.15rem, 2vw, 1.75rem); padding-bottom: 1rem; border-bottom-color: var(--premium-hairline); }\n.ui-card, .data-card, .stat-card { border-radius: var(--premium-radius-sm); }\n.ui-card--interactive:hover, .data-card:hover, .stat-card:hover, .shared-resource-card:hover, .quick-link-card:hover { border-color: color-mix(in srgb, var(--color-action-primary) 42%, var(--premium-border)); box-shadow: 0 1.6rem 4.5rem color-mix(in srgb, #020617 20%, transparent), inset 0 1px 0 var(--premium-highlight); transform: translateY(-3px); }\n.data-card { min-block-size: 5.6rem; padding: clamp(1rem, 2.2vw, 1.35rem); }.data-card::before { display: none; }.data-card__content { gap: .45rem; }.data-card__content p { padding: 0; border: 0; }\n\n.primary-button, .secondary-button { min-block-size: 2.7rem; border-radius: .82rem; font-size: .875rem; font-weight: 750; letter-spacing: -.01em; }\n.primary-button { border-color: color-mix(in srgb, #fff 18%, transparent); background: linear-gradient(135deg, var(--color-action-primary), color-mix(in srgb, var(--color-action-primary) 72%, var(--color-accent-secondary))); box-shadow: 0 .75rem 1.7rem color-mix(in srgb, var(--color-action-primary) 28%, transparent), inset 0 1px 0 color-mix(in srgb, #fff 25%, transparent); }\n.secondary-button { border-color: var(--premium-border); background: color-mix(in srgb, var(--color-bg-secondary) 80%, transparent); box-shadow: inset 0 1px 0 var(--premium-highlight); }\n:is(input:not([type='checkbox']):not([type='radio']), textarea, select) { border-color: var(--premium-border); border-radius: .78rem; background: color-mix(in srgb, var(--color-bg-primary) 78%, var(--color-bg-secondary)); box-shadow: inset 0 1px 1px color-mix(in srgb, #000 7%, transparent), 0 1px 0 var(--premium-highlight); }\n:is(input:not([type='checkbox']):not([type='radio']), textarea, select):focus { border-color: var(--color-action-primary); background: var(--color-bg-primary); box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-action-primary) 15%, transparent), inset 0 1px 1px color-mix(in srgb, #000 6%, transparent); outline: none; }\n.ui-state { border-radius: var(--premium-radius); }.ui-state__icon { display: grid; place-items: center; inline-size: 3.5rem; block-size: 3.5rem; border-radius: 1.2rem; background: color-mix(in srgb, var(--color-action-primary) 12%, var(--color-bg-tertiary)); }\n\n@media (min-width: 768px) { .app-shell { grid-template-columns: minmax(16.75rem, 18.5rem) minmax(0, 1fr); }.sidebar { padding: 1.4rem 1rem 1.1rem; border-right-color: var(--premium-hairline); background: color-mix(in srgb, var(--color-bg-primary) 88%, transparent); box-shadow: 1.1rem 0 3.5rem color-mix(in srgb, #020617 5%, transparent); backdrop-filter: blur(24px) saturate(1.15); }.workspace { padding: clamp(1.75rem, 4vw, 4rem); }.primary-button, .secondary-button { border-radius: .82rem; min-block-size: 2.8rem; } }\n@media (max-width: 47.9375rem) { .workspace { padding: 1rem 1rem calc(6.35rem + env(safe-area-inset-bottom)); }.workspace::before { background-size: 2.8rem 2.8rem; opacity: .2; }.mobile-topbar, .mobile-bottom-nav, .mobile-navigation__panel { border-color: var(--premium-border); background: color-mix(in srgb, var(--color-bg-secondary) 90%, transparent); backdrop-filter: blur(24px) saturate(1.2); }.mobile-bottom-nav { margin: 0 .5rem .5rem; border: 1px solid var(--premium-border); border-radius: 1.2rem; box-shadow: 0 1rem 2.5rem color-mix(in srgb, #020617 22%, transparent); overflow: visible; }.page-hero { min-block-size: auto; padding: 1.35rem; border-radius: 1.2rem; }.page-hero h1 { font-size: clamp(2rem, 10vw, 2.85rem); }.panel { padding: 1rem; border-radius: 1.1rem; } }\n@media (prefers-contrast: more), (forced-colors: active) { .workspace::before { display: none; }.page-hero, .panel, .ui-card, .data-card, .stat-card, .ui-state { box-shadow: none; } }\n",
