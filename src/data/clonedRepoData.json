                      {
                        "id": "file-apps-web-src-components-layouts-PageContainer-tsx",
                        "name": "PageContainer.tsx",
                        "path": "apps/web/src/components/layouts/PageContainer.tsx",
                        "type": "file",
                        "language": "typescript",
                        "content": "import { type ReactNode } from 'react';\nimport { Link } from '@tanstack/react-router';\nimport { AppIcon } from '../AppIcon';\n\nexport interface PageContainerProps {\n  title: string;\n  subtitle?: string;\n  backButton?: { label?: string; to: string };\n  children: ReactNode;\n  footer?: ReactNode;\n  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | 'full';\n  spacing?: 'compact' | 'normal' | 'spacious';\n  ariaLabel?: string;\n}\n\n/** Shared page frame: every utility page receives the same calm hierarchy. */\nexport function PageContainer({ title, subtitle, backButton, children, footer, maxWidth = 'lg', spacing = 'normal', ariaLabel }: PageContainerProps) {\n  return <section aria-label={ariaLabel || title} className={`page-container page-container--${maxWidth} page-container--${spacing}`}>\n    <div className=\"page-container__inner\">\n      <header className=\"page-container__header\">\n        {backButton ? <nav className=\"page-container__back\"><Link to={backButton.to as never} aria-label={`Back to ${backButton.label || 'previous page'}`}><AppIcon name=\"arrow-left\" /> {backButton.label || 'Back'}</Link></nav> : null}\n        <div><p className=\"page-container__eyebrow\">Task Laureate</p><h1>{title}</h1>{subtitle ? <p className=\"page-container__subtitle\">{subtitle}</p> : null}</div>\n      </header>\n      <div className=\"page-container__content\">{children}</div>\n      {footer ? <footer className=\"page-container__footer\">{footer}</footer> : null}\n    </div>\n  </section>;\n}\n",
                        "isModified": false
                      },
                      {
                        "id": "file-apps-web-src-components-layouts-StateComponents-tsx",
                        "name": "StateComponents.tsx",
                        "path": "apps/web/src/components/layouts/StateComponents.tsx",
                        "type": "file",
                        "language": "typescript",
                        "content": "import { type ReactNode } from 'react';\nimport { AppIcon } from '../AppIcon';\n\nexport interface LoadingStateProps {\n  /** Custom loading message (default: \"Loading...\") */\n  message?: string;\n  /** Show a loading spinner (default: true) */\n  showSpinner?: boolean;\n  /** Aria live polite region (default: true) */\n  ariaLive?: boolean;\n}\n\n/**\n * Generic loading state component\n * \n * Provides:\n * - Consistent loading UI across pages\n * - Spinner and message\n * - Accessibility attributes\n * \n * Usage:\n * ```tsx\n * {isLoading && <LoadingState message=\"Loading tasks...\" />}\n * ```\n */\nexport function LoadingState({\n  message = 'Loading...',\n  showSpinner = true,\n  ariaLive = true,\n}: LoadingStateProps) {\n  return (\n    <section\n      className=\"ui-state ui-state--loading\"\n      role=\"status\"\n      aria-live={ariaLive ? 'polite' : undefined}\n      aria-busy=\"true\"\n    >\n      {showSpinner && (\n        <div className=\"ui-state__spinner\" aria-hidden=\"true\">\n          <div />\n        </div>\n      )}\n      <p>{message}</p>\n    </section>\n  );\n}\n\n// ─────────────────────────────────────────\n\nexport interface EmptyStateProps {\n  /** A compact, decorative visual for the state. */\n  icon?: ReactNode;\n  /** Main heading */\n  title: string;\n  /** Optional description text */\n  description?: string;\n  /** Optional action button */\n  action?: {\n    label: string;\n    onClick: () => void;\n  };\n  /** Additional content to display below */\n  children?: ReactNode;\n}\n\n/**\n * Generic empty state component\n * \n * Provides:\n * - Consistent empty state UI\n * - Icon, title, description\n * - Optional action button\n * \n * Usage:\n * ```tsx\n * {items.length === 0 && (\n *   <EmptyState\n *     title=\"No tasks\"\n *     description=\"Create your first task to get started\"\n *     action={{ label: \"Create Task\", onClick: handleCreate }}\n *   />\n * )}\n * ```\n */\nexport function EmptyState({\n  icon = <AppIcon name=\"file\" />,\n  title,\n  description,\n  action,\n  children,\n}: EmptyStateProps) {\n  return (\n    <article className=\"ui-state ui-state--empty\">\n      {icon && (\n        <div className=\"ui-state__icon\" aria-hidden=\"true\">\n          {icon}\n        </div>\n      )}\n      <h2>\n        {title}\n      </h2>\n      {description && (\n        <p>\n          {description}\n        </p>\n      )}\n      {action && (\n        <button\n          onClick={action.onClick}\n          className=\"primary-button\"\n        >\n          {action.label}\n        </button>\n      )}\n      {children}\n    </article>\n  );\n}\n\n// ─────────────────────────────────────────\n\nexport interface ErrorStateProps {\n  /** Error message to display */\n  message: string;\n  /** Optional error details (shown in dev) */\n  details?: string;\n  /** Action to retry or go back */\n  action?: {\n    label: string;\n    onClick: () => void;\n  };\n}\n\n/**\n * Generic error state component\n * \n * Provides:\n * - Consistent error UI\n * - Error message and details\n * - Optional retry/action button\n * \n * Usage:\n * ```tsx\n * {error && <ErrorState message={error.message} />}\n * ```\n */\nexport function ErrorState({ message, details, action }: ErrorStateProps) {\n  return (\n    <article\n      className=\"ui-state ui-state--error\"\n      role=\"alert\"\n    >\n      <div className=\"ui-state__icon\" aria-hidden=\"true\">\n        <AppIcon name=\"warning\" />\n      </div>\n      <h2>\n        {message}\n      </h2>\n      {details && (\n        <p className=\"ui-state__details\">\n          {details}\n        </p>\n      )}\n      {action && (\n        <button\n          onClick={action.onClick}\n          className=\"secondary-button\"\n        >\n          {action.label}\n        </button>\n      )}\n    </article>\n  );\n}\n",
