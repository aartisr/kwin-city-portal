\n    <rect x=\"0\" y=\"0\" width=\"200\" height=\"110\" rx=\"12\" fill=\"url(#card)\" stroke=\"#374151\" stroke-width=\"1\"/>\n    <rect x=\"0\" y=\"0\" width=\"200\" height=\"110\" rx=\"12\" fill=\"#8b5cf6\" fill-opacity=\"0.04\"/>\n    <text x=\"20\" y=\"34\" font-family=\"-apple-system, sans-serif\" font-size=\"12\" font-weight=\"600\" fill=\"#808080\" letter-spacing=\"1\" text-transform=\"uppercase\">LISTS</text>\n    <text x=\"20\" y=\"34\" font-family=\"-apple-system, sans-serif\" font-size=\"12\" font-weight=\"600\" fill=\"#808080\" letter-spacing=\"1\">LISTS</text>\n    <text x=\"20\" y=\"75\" font-family=\"-apple-system, sans-serif\" font-size=\"42\" font-weight=\"800\" fill=\"#f5f5f5\">12</text>\n    <text x=\"20\" y=\"98\" font-family=\"-apple-system, sans-serif\" font-size=\"11\" fill=\"#595959\">View all lists →</text>\n    <text x=\"168\" y=\"40\" font-family=\"-apple-system, sans-serif\" font-size=\"24\">📋</text>\n\n    <!-- Stat card 2: Tasks -->\n    <rect x=\"220\" y=\"0\" width=\"200\" height=\"110\" rx=\"12\" fill=\"url(#card)\" stroke=\"#374151\" stroke-width=\"1\"/>\n    <rect x=\"220\" y=\"0\" width=\"200\" height=\"110\" rx=\"12\" fill=\"#3b82f6\" fill-opacity=\"0.04\"/>\n    <text x=\"240\" y=\"34\" font-family=\"-apple-system, sans-serif\" font-size=\"12\" font-weight=\"600\" fill=\"#808080\" letter-spacing=\"1\">TASKS</text>\n    <text x=\"240\" y=\"75\" font-family=\"-apple-system, sans-serif\" font-size=\"42\" font-weight=\"800\" fill=\"#f5f5f5\">48</text>\n    <text x=\"240\" y=\"98\" font-family=\"-apple-system, sans-serif\" font-size=\"11\" fill=\"#595959\">View all tasks →</text>\n    <text x=\"388\" y=\"40\" font-family=\"-apple-system, sans-serif\" font-size=\"24\">✓</text>\n\n    <!-- Stat card 3: Completed -->\n    <rect x=\"0\" y=\"130\" width=\"200\" height=\"110\" rx=\"12\" fill=\"url(#card)\" stroke=\"#374151\" stroke-width=\"1\"/>\n    <rect x=\"0\" y=\"130\" width=\"200\" height=\"110\" rx=\"12\" fill=\"#10b981\" fill-opac