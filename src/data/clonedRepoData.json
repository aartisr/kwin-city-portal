                        "type": "file",
                        "language": "typescript",
                        "content": "/**\n * Layout Components & Utilities\n * \n * Centralized exports for consistent page structure, layouts, and UI patterns\n * across the entire Laureate application.\n */\n\n// Page layout\nexport { PageContainer } from './PageContainer';\nexport type { PageContainerProps } from './PageContainer';\n\n// State components\nexport { LoadingState, EmptyState, ErrorState } from './StateComponents';\nexport type { LoadingStateProps, EmptyStateProps, ErrorStateProps } from './StateComponents';\n\n// Card and grid layout\nexport { Card, Grid, Section } from './Card';\nexport type { CardProps, GridProps, SectionProps } from './Card';\n",
