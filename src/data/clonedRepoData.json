                    "content": "/*\n * Task list composition\n *\n * The list is intentionally optimised for two modes of work: quick scanning\n * and focused reading. Metadata sits on a quiet second line, while full notes\n * stay in the detail lens instead of making every row a different height.\n */\n.task-list-shell {\n  padding: clamp(1rem, 2.4vw, 1.65rem);\n  border: 1px solid var(--color-border-default);\n  border-radius: calc(var(--radius-xl) + .15rem);\n  background: color-mix(in srgb, var(--color-bg-secondary) 94%, transparent);\n  box-shadow: 0 1.25rem 3.5rem color-mix(in srgb, #172033 7%, transparent);\n}\n\n.task-list { display: grid; gap: clamp(1rem, 2vw, 1.45rem); }\n.task-list--loading { display: grid; min-block-size: 12rem; place-items: center; color: var(--color-text-secondary); }\n.task-list--readonly { opacity: .88; }\n.task-list__header { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; }\n.task-list__header h2, .task-list__header p { margin: 0; }\n.task-list__header h2 { color: var(--color-text-primary); font-size: clamp(1.35rem, 2.5vw, 1.65rem); letter-spacing: -.025em; line-height: 1.15; }\n.task-list__header > div > p:not(.task-list__eyebrow) { margin-top: .34rem; color: var(--color-text-secondary); font-size: .9rem; }\n.task-list__eyebrow { color: var(--color-action-primary); font-size: .72rem; font-weight: var(--font-weight-bold); letter-spacing: .1em; text-transform: uppercase; }\n.task-list__progress { display: grid; gap: .45rem; min-inline-size: min(100%, 12rem); color: var(--color-text-secondary); font-size: .8125rem; font-variant-numeric: tabular-nums; text-align: right; }\n.task-list__progress > div { overflow: hidden; block-size: .42rem; border-radius: 999px; background: color-mix(in srgb, var(--color-border-default) 84%, transparent); }\n.task-list__progress i { display: block; block-size: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--color-status-success), color-mix(in srgb, var(--color-status-success) 72%, var(--color-action-primary))); transition: width var(--transition-base); }\n\n.task-list__toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .65rem 1rem; padding: .42rem; border: 1px solid var(--color-border-default); border-radius: calc(var(--radius-lg) + .1rem); background: color-mix(in srgb, var(--color-bg-tertiary) 76%, transparent); }\n.task-list__filters { display: inline-flex; flex-wrap: wrap; gap: .2rem; }\n.task-list__filters button { display: inline-flex; align-items: center; gap: .42rem; min-block-size: 2.25rem; border: 1px solid transparent; border-radius: calc(var(--radius-md) - .05rem); background: transparent; color: var(--color-text-secondary); cursor: pointer; font: inherit; font-size: .84rem; font-weight: var(--font-weight-semibold); padding: .35rem .65rem; }\n.task-list__filters button span { display: inline-grid; min-inline-size: 1.25rem; block-size: 1.25rem; place-items: center; border-radius: 999px; background: color-mix(in srgb, var(--color-bg-primary) 85%, transparent); color: var(--color-text-secondary); font-size: .7rem; font-variant-numeric: tabular-nums; }\n.task-list__filters button:hover { color: var(--color-text-primary); }\n.task-list__filters button.is-active { border-color: color-mix(in srgb, var(--color-border-default) 92%, transparent); background: var(--color-bg-primary); box-shadow: 0 .1rem .35rem color-mix(in srgb, #172033 11%, transparent); color: var(--color-text-primary); }\n.task-list__filters button.is-active span { background: var(--color-action-primary); color: var(--color-text-on-action, #fff); }\n.task-list__sort { display: inline-flex; align-items: center; gap: .45rem; padding-inline: .3rem .1rem; color: var(--color-text-secondary); font-size: .78rem; font-weight: var(--font-weight-semibold); white-space: nowrap; }\n.task-list__sort select { min-block-size: 2.2rem; border: 1px solid transparent; border-radius: var(--radius-md); background: transparent; color: var(--color-text-primary); cursor: pointer; font: inherit; font-weight: var(--font-weight-semibold); padding: .35rem .45rem; }\n.task-list__sort select:hover { border-color: var(--color-border-default); background: var(--color-bg-primary); }\n.task-list__views { display: inline-flex; align-items: center; gap: .35rem; }.task-list__views select, .task-list__views button { min-block-size: 2.2rem; border: 1px solid var(--color-border-default); border-radius: var(--radius-md); background: var(--color-bg-primary); color: var(--color-text-primary); cursor: pointer; font: inherit; font-size: .78rem; font-weight: var(--font-weight-semibold); padding: .35rem .5rem; }.task-list__views button:hover { border-color: var(--color-action-primary); color: var(--color-action-primary); }\n.task-list__view-options { position: relative; }.task-list__view-options > summary { min-block-size: 2.25rem; display: inline-flex; align-items: center; cursor: pointer; color: var(--color-text-secondary); font-size: .84rem; font-weight: var(--font-weight-semibold); padding: .35rem .65rem; }.task-list__view-options[open] > div { position: absolute; z-index: 4; inset-inline-end: 0; display: grid; gap: .55rem; min-inline-size: 17rem; padding: .65rem; border: 1px solid var(--color-border-default); border-radius: var(--radius-md); background: var(--color-bg-primary); box-shadow: var(--shadow-md); }.task-list__view-options[open] .task-list__sort { justify-content: space-between; }.task-list__view-options[open] .task-list__views { justify-content: space-between; }\n\n.task-list__groups { display: grid; gap: clamp(1.25rem, 2.5vw, 1.8rem); }\n.task-list__group { display: grid; gap: .5rem; }\n.task-list__group-title { display: flex; align-items: center; gap: .45rem; margin: 0; padding-inline: .1rem; color: var(--color-text-secondary); font-size: .72rem; font-weight: var(--font-weight-bold); letter-spacing: .085em; text-transform: uppercase; }\n.task-list__group-title::after { flex: 1; block-size: 1px; margin-left: .25rem; background: var(--color-border-default); content: ''; }\n.task-list__group-title span { display: inline-grid; min-inline-size: 1.28rem; block-size: 1.28rem; place-items: center; border-radius: 999px; background: var(--color-bg-tertiary); font-size: .68rem; font-variant-numeric: tabular-nums; letter-spacing: 0; }\n.task-list__group-title--overdue { color: var(--color-status-error); }.task-list__group-title--due-today { color: var(--color-status-warning); }\n.task-list__items { display: grid; gap: .38rem; }\n.task-list__items--virtual { max-block-size: 35rem; overflow: auto; scrollbar-gutter: stable; }\n.task-list__inline-detail { margin: .1rem .35rem .7rem 2.82rem; border-radius: var(--radius-lg); animation: task-inline-detail-enter .18s ease-out; }.task-list__inline-detail .task-detail-lens { position: static; inline-size: 100%; max-block-size: none; min-block-size: 0; border: 1px solid color-mix(in srgb, var(--color-action-primary) 38%, var(--color-border-default)); border-radius: var(--radius-lg); box-shadow: 0 .8rem 2rem color-mix(in srgb, #172033 10%, transparent); }.task-list__inline-detail--virtual { block-size: 35rem; max-block-size: 35rem; overflow: auto; scrollbar-gutter: stable; }.task-list__inline-detail--virtual .task-detail-lens { min-block-size: 100%; }.task-detail-lens--inline .task-detail-lens__header { position: sticky; z-index: 2; top: 0; background: var(--color-bg-secondary); }.task-detail-lens--inline .task-detail-lens__crumb::before { content: 'Selected task · '; color: var(--color-action-primary); font-weight: var(--font-weight-bold); }.task-detail-lens--inline .task-detail-lens__utility { display: inline-flex; }.task-detail-lens--inline .task-detail-lens__body { overflow: visible; }@keyframes task-inline-detail-enter { from { opacity: 0; transform: translateY(-.35rem); } to { opacity: 1; transform: translateY(0); } }\n\n.task-item { position: relative; content-visibility: auto; contain-intrinsic-size: auto 5.5rem; border: 1px solid transparent; border-radius: calc(var(--radius-lg) - .05rem); background: transparent; color: var(--color-text-primary); transition: border-color var(--transition-base), background var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base); }\n.task-item:hover { border-color: var(--color-border-default); background: var(--color-bg-secondary); box-shadow: 0 .45rem 1rem color-mix(in srgb, #172033 5%, transparent); }\n.task-item--selected { border-color: color-mix(in srgb, var(--color-action-primary) 48%, var(--color-border-default)); background: color-mix(in srgb, var(--color-action-primary) 5%, var(--color-bg-secondary)); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-action-primary) 12%, transparent); }\n.task-item--completed { opacity: .68; }.task-item--deleted { opacity: .65; }.task-item--editing { border-color: var(--color-action-primary); box-shadow: var(--shadow-md); }\n.task-item__row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: start; gap: .7rem; padding: .78rem .82rem; }\n.task-item__content { min-inline-size: 0; }.task-item__complete { display: inline-flex; align-items: center; gap: .28rem; min-block-size: 2.25rem; margin-top: .16rem; border: 1.75px solid var(--color-border-default); border-radius: 999px; background: var(--color-bg-primary); color: var(--color-text-primary); cursor: pointer; font: inherit; font-size: .68rem; font-weight: var(--font-weight-bold); padding: .25rem .5rem .25rem .3rem; transition: border-color var(--transition-base), background var(--transition-base), transform var(--transition-base); }\n.task-item__complete span { white-space: nowrap; }\n.task-item__completion-feedback { align-self: center; color: var(--color-status-success); font-size: .72rem; font-weight: var(--font-weight-semibold); }\n.task-item__complete:hover { border-color: var(--color-status-success); transform: translateY(-1px); }.task-item__complete.is-completed { border-color: var(--color-status-success); background: var(--color-status-success); color: var(--color-text-on-action); }\n.task-item__open { display: grid; min-inline-size: 0; gap: .16rem; border: 0; background: transparent; color: inherit; cursor: pointer; padding: 0; text-align: left; }.task-item__title-line { display: flex; align-items: center; justify-content: space-between; gap: .65rem; min-inline-size: 0; }\n.task-item__title { overflow: hidden; margin: 0; color: var(--color-text-primary); font-size: .94rem; font-weight: var(--font-weight-semibold); line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }.task-item__edit-cta { flex: 0 0 auto; border-radius: 999px; background: color-mix(in srgb, var(--color-action-primary) 9%, var(--color-bg-secondary)); color: var(--color-action-primary); font-size: .68rem; font-weight: var(--font-weight-bold); letter-spacing: .01em; padding: .22rem .42rem; transition: background var(--transition-base), color var(--transition-base); }.task-item__open:hover .task-item__edit-cta, .task-item__open:focus-visible .task-item__edit-cta { background: var(--color-action-primary); color: var(--color-text-on-action, #fff); }\n.task-item--completed .task-item__title { color: var(--color-text-secondary); text-decoration: line-through; }\n.task-item__notes { display: -webkit-box; overflow: hidden; font-size: .82rem; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 1; }\n.task-item__note-meta { color: var(--color-text-tertiary); font-size: .7rem; font-weight: var(--font-weight-semibold); }\n.task-item__priority { align-self: center; border-radius: 999px; font-size: .68rem; font-weight: var(--font-weight-bold); line-height: 1; padding: .32rem .48rem; text-transform: capitalize; white-space: nowrap; }\n.task-item__icon-button, .task-item__delete-confirm { display: inline-grid; inline-size: 2rem; block-size: 2rem; place-items: center; border: 1px solid transparent; border-radius: var(--radius-sm); background: transparent; color: var(--color-text-secondary); cursor: pointer; font: inherit; opacity: 0; transition: border-color var(--transition-base), background var(--transition-base), color var(--transition-base), opacity var(--transition-base); }\n.task-item:hover .task-item__icon-button, .task-item:focus-within .task-item__icon-button { opacity: 1; }.task-item__icon-button:hover { border-color: var(--color-border-default); background: var(--color-bg-primary); color: var(--color-action-primary); }.task-item__icon-button--danger:hover, .task-item__delete-confirm { border-color: var(--color-status-error); background: var(--color-status-error); color: #fff; }\n.task-item__footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; margin-top: 0; padding: 0 .82rem .72rem 2.82rem; border-top: 0; color: var(--color-text-secondary); font-size: .75rem; }\n.task-item__tags, .task-item__dates, .task-item__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; margin-top: 0; }.task-item__tag, .task-item__due, .task-item__completed-date { border-radius: 999px; background: var(--color-bg-tertiary); padding: .2rem .45rem; }.task-item__tag { color: var(--color-text-secondary); font-size: .7rem; }.task-item__readonly-check { display: grid; place-items: center; inline-size: 1.5rem; block-size: 1.5rem; margin-right: .1rem; border-radius: 999px; background: rgba(148, 163, 184, .18); color: var(--color-text-secondary); font-weight: 700; }.task-item__deleted-label { margin: .25rem 0 0; color: var(--color-text-secondary); font-size: .8rem; }\n.task-item__dependency-pulse { border: 0; border-radius: 999px; cursor: pointer; font: inherit; font-size: .7rem; font-weight: var(--font-weight-bold); padding: .2rem .45rem; white-space: nowrap; }.task-item__dependency-pulse.is-blocked { background: color-mix(in srgb, var(--color-status-warning) 18%, var(--color-bg-tertiary)); color: #9a3412; }.task-item__dependency-pulse.is-unblocking { background: color-mix(in srgb, var(--color-action-primary) 12%, var(--color-bg-tertiary)); color: var(--color-action-primary); }.task-item__dependency-pulse:hover { filter: brightness(.96); text-decoration: underline; }\n.task-item--in-progress { border-color: color-mix(in srgb, var(--color-status-info) 42%, var(--color-border-default)); }.task-item__start, .task-item__work-state { display: inline-flex; align-items: center; gap: .35rem; min-block-size: 1.8rem; border-radius: 999px; font: inherit; font-size: .72rem; font-weight: var(--font-weight-bold); padding: .2rem .55rem; white-space: nowrap; }.task-item__start { border: 1px solid color-mix(in srgb, var(--color-status-info) 45%, var(--color-border-default)); background: color-mix(in srgb, var(--color-status-info) 10%, var(--color-bg-primary)); color: var(--color-status-info); cursor: pointer; }.task-item__start:hover, .task-item__start:focus-visible { border-color: var(--color-status-info); background: color-mix(in srgb, var(--color-status-info) 18%, var(--color-bg-primary)); }.task-item__work-state { background: color-mix(in srgb, var(--color-status-info) 12%, var(--color-bg-tertiary)); color: var(--color-status-info); }.task-item__work-state i { inline-size: .48rem; block-size: .48rem; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 .18rem color-mix(in srgb, currentColor 18%, transparent); }\n.task-item__complete:focus-visible, .task-item__open:focus-visible, .task-item__icon-button:focus-visible, .task-list__filters button:focus-visible, .task-list__sort select:focus-visible { outline: 3px solid color-mix(in srgb, var(--color-action-primary) 35%, transparent); outline-offset: 2px; }\n.task-list__empty { display: grid; justify-items: center; gap: .35rem; min-block-size: 14rem; place-content: center; border: 1px dashed var(--color-border-default); border-radius: var(--radius-xl); background: var(--color-bg-tertiary); color: var(--color-text-secondary); text-align: center; }.task-list__empty span { color: var(--color-action-primary); font-size: 1.75rem; }.task-list__empty h3, .task-list__empty p { margin: 0; }.task-list__empty h3 { color: var(--color-text-primary); font-size: 1rem; }\n\n@media (max-width: 40rem) {\n  .task-list-shell { padding: 1rem; border-radius: var(--radius-lg); }\n  .task-list__header, .task-list__toolbar { align-items: stretch; }.task-list__progress { inline-size: 100%; text-align: left; }.task-list__toolbar { display: grid; }.task-list__sort { justify-content: space-between; }.task-list__sort select { flex: 1; }\n  .task-item__row { grid-template-columns: auto minmax(0, 1fr) auto; gap: .6rem; padding: .75rem; }.task-item__priority { display: none; }.task-item__icon-button { display: none; }.task-item__footer { padding: 0 .75rem .68rem 2.55rem; }.task-list__inline-detail { margin-inline: .1rem; margin-inline-start: 2.55rem; }.task-item__title { white-space: normal; }.task-item__notes { -webkit-line-clamp: 2; }.task-item__edit-cta { font-size: .63rem; }\n}\n\n@media (hover: none) { .task-item__icon-button { opacity: 1; } }\n@media (max-width: 40rem) { .task-list__inline-detail--virtual { block-size: 29rem; max-block-size: 29rem; } }\n@media (prefers-reduced-motion: reduce) { .task-item, .task-item__complete, .task-item__icon-button, .task-list__progress i, .task-list__inline-detail { transition: none; animation: none; } }\n",
