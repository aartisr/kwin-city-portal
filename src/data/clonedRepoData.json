                  {
                    "id": "file-apps-web-src-components-ListCard-tsx",
                    "name": "ListCard.tsx",
                    "path": "apps/web/src/components/ListCard.tsx",
                    "type": "file",
                    "language": "typescript",
                    "content": "import { Link } from '@tanstack/react-router';\nimport { useState } from 'react';\nimport type { TodoList } from '../core/contracts/domain';\nimport { archiveRecommendation } from '../core/domain/listLifecycle';\nimport { announceToScreenReader } from '../lib/a11y';\nimport { AppIcon } from './AppIcon';\nimport { FavoriteListButton } from './FavoriteListButton';\nimport { ListShareButton } from './ListShareButton';\nimport { ListStatusBadge } from './ListStatusBadge';\nimport { ProgressRing } from './ProgressRing';\nimport '../styles/components/list-card.css';\n\nexport interface ListCardProps {\n  list: TodoList;\n  canManage: boolean;\n  onDelete: () => Promise<void>;\n  onArchive: () => Promise<void>;\n  onRestore: () => Promise<void>;\n  onReuse: () => Promise<void>;\n  onShare: () => void;\n}\n\n/** One action-complete list representation, reusable in collections and shelves. */\nexport function ListCard({ list, onDelete, onArchive, onRestore, onReuse, onShare, canManage }: ListCardProps) {\n  const remaining = list.taskCount - list.completedTaskCount;\n  const [manageOpen, setManageOpen] = useState(false);\n  const [deleteArmed, setDeleteArmed] = useState(false);\n  const [isSaving, setIsSaving] = useState(false);\n  const run = async (action: () => Promise<void>) => {\n    setIsSaving(true);\n    try { await action(); setManageOpen(false); setDeleteArmed(false); }\n    catch { announceToScreenReader('That change could not be saved. Please try again.', 'assertive'); }\n    finally { setIsSaving(false); }\n  };\n  return <article className=\"list-card\">\n    <div className=\"list-card__header\"><div className=\"list-card__meta\"><ListStatusBadge status={list.status} /><span className=\"list-card__date\">{new Date(list.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span></div><ProgressRing percent={list.completionPercent} size={52} /></div>\n    <h3 className=\"list-card__title\">{list.title}</h3>\n    {list.description ? <p className=\"list-card__desc\">{list.description}</p> : null}\n    <div className=\"list-card__bar\"><div className=\"list-card__bar-fill\" style={{ '--bar-pct': `${list.completionPercent}%` } as React.CSSProperties} /></div>\n    <div className=\"list-card__footer\"><span>{list.completedTaskCount}/{list.taskCount} tasks</span>{remaining > 0 ? <span className=\"list-card__remaining\">{remaining} remaining</span> : null}{list.completionPercent === 100 ? <span className=\"list-card__done\"><AppIcon name=\"check\" /> Done</span> : null}</div>\n    <div className=\"list-card__actions\">\n      <Link to=\"/lists/$listId\" params={{ listId: list.id }} className=\"primary-button list-card__open\"><span>Open list</span> <AppIcon name=\"arrow-right\" /></Link>\n      <div className=\"list-card__secondary-actions\">\n        <FavoriteListButton listId={list.id} listTitle={list.title} className=\"list-card__keep-handy\" />\n        {canManage ? <><ListShareButton listTitle={list.title} onClick={onShare} /><button type=\"button\" aria-expanded={manageOpen} className=\"secondary-button list-card__manage\" onClick={() => setManageOpen((open) => !open)}><AppIcon name=\"more\" /><span>More</span></button></> : null}\n      </div>\n    </div>\n    {canManage && manageOpen ? <div className=\"list-card__menu\" aria-label={`Manage ${list.title}`}>\n      {list.status === 'completed' ? <><p className=\"list-card__menu-copy\">This run is complete. Its history is preserved.</p><button type=\"button\" className=\"list-card__menu-action list-card__menu-action--archive\" disabled={isSaving} onClick={() => void run(onReuse)}><AppIcon name=\"undo\" /> Start a fresh run</button></> : null}\n      {list.status === 'archived' ? <button type=\"button\" className=\"list-card__menu-action list-card__menu-action--archive\" disabled={isSaving} onClick={() => void run(onRestore)}><AppIcon name=\"undo\" /> Restore to {list.archivedFromStatus === 'completed' ? 'completed' : 'in progress'}</button> : <button type=\"button\" className=\"list-card__menu-action list-card__menu-action--archive\" disabled={isSaving} onClick={() => void run(onArchive)}><AppIcon name=\"archive\" /> {archiveRecommendation(list) ? 'Archive recommended' : 'Archive from daily view'}</button>}\n      {deleteArmed ? <div className=\"list-card__danger\"><span>Move to deleted items? You can undo this.</span><div className=\"list-card__danger-actions\"><button type=\"button\" className=\"list-card__menu-action list-card__menu-action--danger\" disabled={isSaving} onClick={() => void run(onDelete)}><AppIcon name=\"trash\" /> Yes, delete</button><button type=\"button\" className=\"list-card__menu-action list-card__menu-action--cancel\" onClick={() => setDeleteArmed(false)}>Cancel</button></div></div> : <button type=\"button\" className=\"list-card__menu-action list-card__menu-action--delete\" onClick={() => setDeleteArmed(true)}><AppIcon name=\"trash\" /> Delete list…</button>}\n    </div> : null}\n  </article>;\n}\n",
                    "isModified": false
                  },
                  {
                    "id": "file-apps-web-src-components-ListComposer-test-tsx",
                    "name": "ListComposer.test.tsx",
                    "path": "apps/web/src/components/ListComposer.test.tsx",
                    "type": "file",
                    "language": "typescript",
                    "content": "import { act } from 'react';\nimport { createRoot, type Root } from 'react-dom/client';\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\nimport { ListComposer } from './ListComposer';\n\ndescribe('ListComposer', () => {\n  let host: HTMLDivElement;\n  let root: Root;\n\n  beforeEach(() => {\n    (globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;\n    host = document.createElement('div');\n    document.body.appendChild(host);\n    root = createRoot(host);\n  });\n\n  afterEach(async () => {\n    await act(async () => root.unmount());\n    host.remove();\n  });\n\n  it('starts with one required decision and keeps context out of the fast path', async () => {\n    const scrollIntoView = vi.fn();\n    Object.defineProperty(HTMLElement.prototype, 'scrollIntoView', { configurable: true, value: scrollIntoView });\n    await act(async () => { root.render(<ListComposer onCreate={vi.fn()} onCancel={vi.fn()} />); });\n\n    const titleInput = host.querySelector<HTMLInputElement>('#list-composer-title');\n    expect(titleInput).not.toBeNull();\n    expect(document.activeElement).toBe(titleInput);\n    expect(scrollIntoView).toHaveBeenCalledWith(expect.objectContaining({ block: 'center' }));\n    expect(host.textContent).toContain('Create & add tasks');\n    expect(host.textContent).toContain('Press Enter to create');\n\n    const advanced = host.querySelector<HTMLDetailsElement>('.list-composer__details');\n    expect(advanced?.open).toBe(false);\n    await act(async () => advanced?.querySelector('summary')?.click());\n    expect(advanced?.open).toBe(true);\n    expect(host.querySelector<HTMLTextAreaElement>('#list-composer-description')).not.toBeNull();\n  });\n});\n",
                    "isModified": false
                  },
                  {
                    "id": "file-apps-web-src-components-ListComposer-tsx",
                    "name": "ListComposer.tsx",
                    "path": "apps/web/src/components/ListComposer.tsx",
                    "type": "file",
                    "language": "typescript",
                    "content": "import { type FormEvent, useLayoutEffect, useRef, useState } from 'react';\nimport type { TodoListInput } from '../core/contracts/repository';\n\nexport function ListComposer({ onCreate, onCancel, initialInput, restoredDraft = false }: {\n  onCreate: (input: TodoListInput) => Promise<void>;\n  onCancel: () => void;\n  initialInput?: Pick<TodoListInput, 'title' | 'description'>;\n  restoredDraft?: boolean;\n}) {\n  const composerRef = useRef<HTMLFormElement>(null);\n  const titleInputRef = useRef<HTMLInputElement>(null);\n  const [title, setTitle] = useState(initialInput?.title ?? '');\n  const [description, setDescription] = useState(initialInput?.description ?? '');\n  const [saving, setSaving] = useState(false);\n  const [error, setError] = useState('');\n\n  // This component is only mounted after someone deliberately asks to create a\n  // List. Keeping the reveal and focus here guarantees every entry point\n  // (navigation, keyboard shortcut, and cards) lands at the same first step.\n  useLayoutEffect(() => {\n    const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;\n    composerRef.current?.scrollIntoView?.({ block: 'center', behavior: reducedMotion ? 'auto' : 'smooth' });\n    titleInputRef.current?.focus({ preventScroll: true });\n  }, []);\n\n  const submit = async (event: FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    if (!title.trim() || saving) return;\n    setSaving(true);\n    setError('');\n    try {\n      await onCreate({ title: title.trim(), description: description.trim() || undefined });\n    } catch (reason) {\n      setError(reason instanceof Error ? reason.message : 'We could not create this list. Please try again.');\n      setSaving(false);\n    }\n  };\n\n  return <form ref={composerRef} className=\"list-composer\" onSubmit={(event) => void submit(event)} aria-label=\"Create a new list\">\n    <div className=\"list-composer__heading\"><p className=\"eyebrow\">New private list</p><h2>Name it. Start moving.</h2><p>One name is enough. You can add tasks and refine the details next.</p>{restoredDraft ? <p className=\"list-composer__restored\" role=\"status\">Your draft was restored. Review it, then create your private list.</p> : null}</div>\n    <label className=\"list-composer__title\" htmlFor=\"list-composer-title\">What are you organizing?<input id=\"list-composer-title\" ref={titleInputRef} value={title} onChange={(event) => setTitle(event.target.value)} placeholder=\"e.g. Spring launch\" autoComplete=\"off\" enterKeyHint=\"go\" maxLength={255} required /><small>Press Enter to create and add your first task.</small></label>\n    <details className=\"list-composer__details\"><summary>Add context <span>(optional)</span></summary><label htmlFor=\"list-composer-description\">Description<textarea id=\"list-composer-description\" value={description} onChange={(event) => setDescription(event.target.value)} placeholder=\"A sentence to help future you.\" maxLength={1000} rows={2} /></label></details>\n    {error ? <p className=\"list-composer__error\" role=\"alert\">{error}</p> : null}\n    <div className=\"list-composer__actions\"><button className=\"primary-button\" type=\"submit\" disabled={!title.trim() || saving}>{saving ? 'Creating…' : 'Create & add tasks'} <span aria-hidden=\"true\">→</span></button><button className=\"secondary-button\" type=\"button\" onClick={onCancel} disabled={saving}>Cancel</button></div>\n  </form>;\n}\n",
                    "isModified": false
                  },
                  {
                    "id": "file-apps-web-src-components-ListShareButton-tsx",
